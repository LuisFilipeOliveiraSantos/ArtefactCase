# Google Gemini API key — free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: model (default gemini-3.5-flash-lite; gemini-3.5-flash is stronger but
# its free tier allows only ~20 requests per day)
# EMPORIO_MODEL=gemini-3.5-flash

# Optional: any other OpenAI-compatible provider (e.g. Groq, local Ollama)
# EMPORIO_BASE_URL=http://localhost:11434/v1
# EMPORIO_API_KEY=ollama

# Optional: where conversation history is stored
# EMPORIO_DB_PATH=.sessions/conversations.db
